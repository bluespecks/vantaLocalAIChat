Screen {
    background: #0b0e14;
}

Header {
    background: #111722;
    color: #aab5c8;
}

Footer {
    background: #111722;
    color: #aab5c8;
}

#welcome-area {
    width: 100%;
    height: 1fr;
    align: center middle;
}

#welcome-panel {
    width: 64;
    max-width: 90%;
    height: auto;
    padding: 2 3;
    border: round #414d63;
    background: #111722;
    align: center middle;
}

#brand {
    color: #8be9fd;
    text-style: bold;
    text-align: center;
    margin-bottom: 2;
}

#tagline {
    color: #f1f5f9;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

#description {
    color: #aab5c8;
    text-align: center;
    margin-bottom: 2;
}

#status {
    color: #7ee787;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

#hint {
    color: #7f8a9e;
    text-align: center;
}
